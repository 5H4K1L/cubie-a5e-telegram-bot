#!/bin/sh /etc/rc.common
# procd service for ImmortalWrt and OpenWrt
USE_PROCD=1
START=99
STOP=10

APP_DIR="/opt/cubie-a5e-telegram-bot"
PYTHON="/usr/bin/python3"

start_service() {
    [ -x "$PYTHON" ] || return 1
    [ -f "$APP_DIR/bot.py" ] || return 1
    procd_open_instance
    procd_set_param command "$PYTHON" "$APP_DIR/bot.py"
    procd_set_param env PYTHONUNBUFFERED=1
    procd_set_param directory "$APP_DIR"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
