# Required Telegram settings
TELEGRAM_BOT_TOKEN=put_your_bot_token_here
TELEGRAM_OWNER_ID=123456789

# Router and traffic accounting
TIMEZONE=Asia/Dhaka
# Set this if default-route detection chooses the wrong WAN device (e.g. pppoe-wan)
WAN_INTERFACE=pppoe-wan
TRAFFIC_DB=/etc/cubie-a5e-telegram-bot/traffic.sqlite3
SAMPLE_INTERVAL=60
ALERT_INTERVAL=300

# Usage report times in local TIMEZONE
DAILY_REPORT_TIME=08:00
MONTHLY_REPORT_TIME=08:05

# Read-only Gemini AI (optional)
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_TIME=08:15
AI_WEEKLY_DAY=0
AI_WEEKLY_TIME=08:20
AI_MONTHLY_DAY=1
AI_MONTHLY_TIME=08:25

# Alert thresholds
TEMPERATURE_ALERT_C=80
MEMORY_ALERT_PERCENT=90
DISK_ALERT_PERCENT=90
LOG_LEVEL=INFO
